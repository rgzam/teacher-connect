# Copy this file to .env and keep real secrets out of git.
# Local Postgres is started by: pnpm db:up

# Database
DATABASE_URL=postgresql://teacherconnect:teacherconnect@localhost:5432/teacherconnect?schema=public

# API (NestJS)
API_PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-this-with-a-long-random-string

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Calendar (optional — booking works without this)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback

# Email (optional — local uses Ethereal preview links if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TeacherConnect <no-reply@teacherconnect.local>
